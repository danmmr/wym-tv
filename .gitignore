# Bundle artifact
*.jsbundle

# Generated by `react-native bundle` before assembleRelease (see README).
# Gradle regenerates these from source on every build, so they are not sources.
android/app/src/main/assets/index.android.bundle
android/app/src/main/res/drawable-hdpi/
android/app/src/main/res/drawable-mdpi/
android/app/src/main/res/drawable-xhdpi/
android/app/src/main/res/drawable-xxhdpi/
android/app/src/main/res/drawable-xxxhdpi/

# May hold a Plex account token. Copy plex.example.ts to plex.ts and fill in
# your own values (the token itself is optional — see that file).
src/config/plex.ts

# The real LAN map: Plex server, WiiM units, Fire Sticks, scan subnets. Private
# addresses are not secrets, but they are this network's layout and they are of
# no use to anyone else. Copy hosts.data.example.json to hosts.data.json.
src/config/hosts.data.json

