# May hold a Plex account token. Copy plex.example.ts to plex.ts and fill in
# your own values (the token itself is optional — see that file).
src/config/plex.ts

# The real LAN map: Plex server, WiiM units, Fire Sticks, scan subnets. Private
# addresses are not secrets, but they are this network's layout and they are of
# no use to anyone else. Copy hosts.data.example.json to hosts.data.json.
src/config/hosts.data.json

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

